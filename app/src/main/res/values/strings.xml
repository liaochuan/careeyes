    <string name="onboarding_title">Welcome</string>
    <string name="onboarding_intro_title">Care for your eyes</string>
    <string name="onboarding_intro_body">CareEyes follows the 20-20-20 rule: after 20 minutes of screen time, look 20 feet (6 m) away for 20 seconds. Everything stays on this device: no account, no network permission.</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_body">These keep reminders reliable. You can change them anytime in Settings.</string>
    <string name="onboarding_skip">Skip for now</string>
    <string name="onboarding_done">Done</string>
    <string name="permission_optional">Optional</string>
    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_desc">Shows the timer and delivers break reminders. Without it you may miss breaks unless CareEyes is open.</string>
    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_desc">Lets the break screen cover other apps. Without it, breaks arrive only as a notification. On some phones (for example MIUI/HyperOS) also allow \"Pop-up in background\" for CareEyes in system settings.</string>
    <string name="permission_battery_title">Battery optimization</string>
    <string name="permission_battery_desc">Keeps background timing from being stopped. Without it, the timer may freeze or reset when the screen is off.</string>
    <string name="permission_media_title">Notification access</string>
    <string name="permission_media_desc">Used only to pause videos when a break starts. Without it, videos keep playing and other features are unaffected.</string>
    <string name="permission_usage_title">Usage access</string>
    <string name="permission_usage_desc">Used only to tell which app is on screen, so a break pauses video but leaves background music playing. Without it, automatic pausing stays off.</string>
    <string name="settings_permission_fullscreen">Full-screen alerts</string>
    <string name="settings_permission_fullscreen_desc">Android 14 and later need this allowed to show the break page over other apps from the background; otherwise a banner notification is shown.</string>
