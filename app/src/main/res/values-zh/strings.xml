    <string name="onboarding_title">欢迎</string>
    <string name="onboarding_intro_title">温和地护眼</string>
    <string name="onboarding_intro_body">护眼时刻遵循 20-20-20 法则：每用眼 20 分钟，看向 6 米（20 英尺）外约 20 秒。所有数据仅保存在本机，无需账号，也没有网络权限。</string>
    <string name="onboarding_permissions_title">权限设置</string>
    <string name="onboarding_permissions_body">这些权限保证提醒能准时送达，之后可随时在设置中调整。</string>
    <string name="onboarding_skip">暂时跳过</string>
    <string name="onboarding_done">完成</string>
    <string name="permission_optional">可选</string>
    <string name="permission_notifications_title">通知权限</string>
    <string name="permission_notifications_desc">用于显示计时状态并送达休息提醒。未开启时，只有打开应用才能看到提醒，容易错过休息。</string>
    <string name="permission_overlay_title">悬浮窗权限</string>
    <string name="permission_overlay_desc">用于在其他应用上方显示全屏休息页。未开启时，休息提醒只在通知栏出现，无法全屏提示。部分手机（如 MIUI/HyperOS）还需在系统设置中允许「后台弹出界面」。</string>
    <string name="permission_battery_title">忽略电池优化</string>
    <string name="permission_battery_desc">避免后台计时被系统中断。未开启时，息屏或切到后台后计时可能停止甚至重置。</string>
    <string name="permission_media_title">通知使用权</string>
    <string name="permission_media_desc">仅用于休息开始时暂停其他应用的视频。未开启时视频会继续播放，其他功能不受影响。</string>
    <string name="permission_usage_title">使用情况访问</string>
    <string name="permission_usage_desc">仅用于判断当前正在使用的应用，让休息时只暂停前台视频、不打断后台音乐。未开启时不会自动暂停。</string>
    <string name="settings_permission_fullscreen">全屏提醒</string>
    <string name="settings_permission_fullscreen_desc">Android 14 及以上需允许此项，后台休息才能直接全屏展示；否则只显示横幅通知。</string>
